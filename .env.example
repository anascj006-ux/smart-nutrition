PORT=5000
# Google Gemini API Key for Primary Multimodal Food Recognition & Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model (e.g., gemini-3.8-flash, gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# Force Demo Mode Fallback (true to use predefined database, false for live Gemini AI)
DEMO_MODE=false
